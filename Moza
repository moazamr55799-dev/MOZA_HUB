local function SafeCheckCharacter()
    local c = P.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
        return c
    end
    return nil
end

-- Smart Quest System Data Handlers
local function GetQuestData()
    local lvl = P.Data.Level.Value
    if lvl >= 1 and lvl < 10 then return "BanditQuest1", 1, "Bandit"
    elseif lvl >= 10 and lvl < 15 then return "MonkeyQuest1", 1, "Monkey"
    elseif lvl >= 15 and lvl < 30 then return "GorillaQuest1", 1, "Gorilla"
    elseif lvl >= 30 and lvl < 40 then return "PirateQuest", 1, "Pirate"
    elseif lvl >= 40 and lvl < 60 then return "PirateQuest", 2, "Brute"
    elseif lvl >= 60 and lvl < 75 then return "DesertQuest", 1, "Desert Bandit"
    elseif lvl >= 75 and lvl < 90 then return "DesertQuest", 2, "Desert Officer"
    elseif lvl >= 90 and lvl < 120 then return "SnowQuest", 1, "Snow Bandit"
    elseif lvl >= 120 and lvl < 150 then return "SnowQuest", 2, "Snowman"
    else return "BanditQuest1", 1, "Bandit" end
end

