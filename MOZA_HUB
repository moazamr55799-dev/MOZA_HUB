task.spawn(function()
    while true do task.wait()
        if Farm or FarmBoss or AutoRaid or AutoSeaEvent or AutoOdenQuest or AutoZoroQuest then pcall(function()
            local targets = {}
            if AutoSeaEvent then
                for _, s in pairs(workspace:GetChildren()) do
                    if (s.Name == "Ship" or s.Name == "SeaBeast" or s.Name == "Sea Beast") and s:FindFirstChild("HumanoidRootPart") then
                        table.insert(targets, s)
                    end
                end
            end
            if #targets == 0 and AutoRaid then
                for _, r in pairs(workspace.Enemies:GetChildren()) do
                    if r:FindFirstChild("Humanoid") and r.Humanoid.Health > 0 and r:FindFirstChild("HumanoidRootPart") then
                        table.insert(targets, r)
                    end
                end
            end
            if #targets == 0 then
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 and e:FindFirstChild("HumanoidRootPart") then
                        table.insert(targets, e)
                    end
                end
            end

            for _, target in pairs(targets) do
                local c = P.Character
                local targetTool = nil
                
                if SelectWeapon == "Melee" then 
                    targetTool = P.Backpack:FindFirstChild("Combat") or P.Backpack:FindFirstChildOfClass("Tool")
                else
                    for _, w in pairs(P.Backpack:GetChildren()) do 
                        if w:IsA("Tool") and w.ToolTip == SelectWeapon then targetTool = w break end 
                    end
                end
                
                if not targetTool and c:FindFirstChildOfClass("Tool") then targetTool = c:FindFirstChildOfClass("Tool") end
                if targetTool then c.Humanoid:EquipTool(targetTool) end
                
                c.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0)
                
                VU:CaptureController()
                VU:Button1Down(Vector2.new(1280, 720))
                
                if FastAttack then
                    task.wait(0.01)
                    VU:Button1Up(Vector2.new(1280, 720))
                    VU:Button1Down(Vector2.new(1280, 720))
                end
            end
        end) end
    end
end)

